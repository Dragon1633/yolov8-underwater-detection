             <widget class="QTabWidget" name="tabWidget">
              <property name="styleSheet">
               <string notr="true">QTabWidget::pane {
    border: none;
}

QTabBar::tab {
    /* background: #f0f0f0; 设置默认状态下的背景颜色 */
    border: 1px solid #C2C7CB; /* 设置边框颜色 */
    border-bottom-color: #828282; /* 设置底部边框颜色 */
    min-width: 10ex; /* 最小宽度 */
    padding: 5px; /* 内边距 */
}

QTabBar::tab:selected, QTabBar::tab:hover {
     background: #e0e0e0; /* 设置选中或悬停状态下的背景颜色 */
}
QTabBar::tab:selected {
    background: #e0e0e0; /* 设置选中状态下的背景颜色 */
    border-color: #828282; /* 选中时的边框颜色 */
    border-bottom-color: #fff; /* 底部边框颜色 */
    margin-bottom: 0px; /* 调整底部间距以产生凸起效果 */
}
</string>
