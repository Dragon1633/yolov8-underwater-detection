           <property name="styleSheet">
            <string notr="true">QPushButton {
    background-color: rgb(192, 216, 255); /* 浅灰色 */
    border: 1px solid #d4d4d4; /* 灰色边框 */
    border-radius: 8px; /* 圆角 */
    padding: 5px 10px; /* 内边距 */
    color: #333; /* 按钮文字颜色 */
}
QPushButton:hover {
    background-color: rgb(235, 242, 255); /* 鼠标悬停时变亮 */
}
QPushButton:pressed {
    background-color: rgb(157, 178, 255); /* 按下时颜色变深 */
}</string>
